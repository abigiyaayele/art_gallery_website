{
  "name": "artist-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:dashboard": "pnpm --filter @platform/dashboard dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @platform/api db:migrate",
    "db:seed": "pnpm --filter @platform/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.19.0"
  }
}
