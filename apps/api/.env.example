# Postgres connection
DATABASE_URL=postgres://platform:platform@localhost:5432/platform
# Used by integration tests (wiped on every run)
TEST_DATABASE_URL=postgres://platform:platform@localhost:5432/platform_test

PORT=4000
# Secret for signing access tokens: at least 32 random characters
JWT_SECRET=change-me-to-a-long-random-string-0123456789
# 32-byte key (base64) for encrypting tenant secrets such as payment keys: `openssl rand -base64 32`
ENCRYPTION_KEY=
# Where the dashboard runs, for CORS and cookies
DASHBOARD_ORIGIN=http://localhost:5173
# Base domain for tenant subdomains: seifu.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=localhost

# First platform admin, created by `pnpm db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
SEED_DEMO_TENANTS=true
