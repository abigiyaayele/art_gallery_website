# The platform's own domain. Artists get <slug>.<domain>; the dashboard is app.<domain>.
PLATFORM_DOMAIN=example-artists.com
ACME_EMAIL=you@example.com

POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  (encrypts artists' payment keys; keep it safe and never change it)
ENCRYPTION_KEY=
S3_ACCESS_KEY=platform
S3_SECRET_KEY=change-me-too

# First platform admin, created on `db:seed`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: turns on the AI assistant.
ANTHROPIC_API_KEY=

# Where images come from (set by the release workflow) and which tag to run.
IMAGE_PREFIX=ghcr.io/abigiyaayele/art-platform
TAG=latest
